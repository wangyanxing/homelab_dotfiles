#!/usr/bin/env bash
# Cross-platform package installer for a fresh machine.
# Runs once (chezmoi tracks its hash). Installs the modern CLI stack that this
# dotfiles setup depends on. Safe to re-run: package managers skip installed pkgs.
set -euo pipefail

echo ">>> [dotfiles] bootstrapping packages ..."

# ---------------------------------------------------------------------------
# Package list (logical names). Mapped per-platform below.
#   starship  - prompt
#   zoxide    - `z` smart dir jump (replaces fasd)
#   fzf       - fuzzy finder
#   eza       - modern `ls` (ll)
#   bat       - modern `cat`
#   fd        - modern `find`
#   ripgrep   - modern `grep` (rg)
#   git-delta - pretty git diffs
#   atuin     - shell history search/sync
#   zellij    - terminal multiplexer
#   neovim    - editor (LazyVim)
#   mise      - runtime version manager (replaces rbenv/nvm, no prompt clutter)
#   antidote  - zsh plugin manager
# ---------------------------------------------------------------------------

# --- shared helper: install a single-binary tool from a GitHub release ------
# usage: gh_install <bin_name> <owner/repo> <asset_grep_pattern>
# Robust: a failure here never aborts the whole bootstrap (runs in a subshell
# with errexit disabled; network / rate-limit / missing-asset errors tolerated).
gh_install() {
  local bin="$1" repo="$2" pattern="$3"
  if command -v "$bin" >/dev/null 2>&1; then echo "    ok   $bin"; return 0; fi
  echo "    install $bin (github: $repo)"
  ( set +e
    url=$(curl -fsSL "https://api.github.com/repos/$repo/releases/latest" 2>/dev/null \
          | grep -oE '"browser_download_url": *"[^"]+"' \
          | cut -d'"' -f4 \
          | grep -Ev 'sha256|\.sig|\.sbom|server|musleabi|no-web' \
          | grep -E "$pattern" | head -1)
    if [[ -z "$url" ]]; then echo "    !! no asset for $bin ($pattern), skip"; exit 0; fi
    tmp="$(mktemp -d)"
    if ! curl -fsSL "$url" -o "$tmp/dl"; then echo "    !! download failed for $bin, skip"; rm -rf "$tmp"; exit 0; fi
    case "$url" in
      *.tar.gz|*.tgz) tar -xzf "$tmp/dl" -C "$tmp" 2>/dev/null ;;
      *.zip)          unzip -q "$tmp/dl" -d "$tmp" 2>/dev/null ;;
      *)              cp "$tmp/dl" "$tmp/$bin"; chmod +x "$tmp/$bin" ;;
    esac
    found="$(find "$tmp" -type f -name "$bin" | head -1)"
    if [[ -n "$found" ]]; then install -m755 "$found" "$HOME/.local/bin/$bin" && echo "    done $bin"; else echo "    !! binary '$bin' not found in asset, skip"; fi
    rm -rf "$tmp"
  )
  return 0
}

{{ if eq .chezmoi.os "darwin" -}}
# ============================ macOS (Homebrew) ============================
# Ensure Xcode Command Line Tools are present (git/clang). On a brand-new Mac
# this may pop a GUI installer dialog you must click through.
if ! xcode-select -p >/dev/null 2>&1; then
  echo ">>> triggering Xcode Command Line Tools install (follow the GUI prompt) ..."
  xcode-select --install || true
  echo ">>> waiting for Command Line Tools to finish installing ..."
  until xcode-select -p >/dev/null 2>&1; do sleep 5; done
fi

if ! command -v brew >/dev/null 2>&1 && [[ ! -x /opt/homebrew/bin/brew && ! -x /usr/local/bin/brew ]]; then
  echo ">>> Homebrew not found; installing (it will ask for your admin password) ..."
  # NOTE: no NONINTERACTIVE here on purpose — the installer needs a TTY to
  # prompt for your sudo password. `|| true` so a failure doesn't abort apply.
  /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)" || true
fi

# CRITICAL: put brew on PATH for the rest of THIS script (fresh install case).
if [[ -x /opt/homebrew/bin/brew ]]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"      # Apple Silicon
elif [[ -x /usr/local/bin/brew ]]; then
  eval "$(/usr/local/bin/brew shellenv)"         # Intel
fi

# If brew still isn't available (no admin rights, install cancelled, or no TTY),
# don't hard-fail: fall back to pulling static binaries from GitHub releases
# into ~/.local/bin (same approach as the Linux branch, no admin needed).
if ! command -v brew >/dev/null 2>&1; then
  echo ">>> Homebrew unavailable; falling back to GitHub-release binaries in ~/.local/bin ..."
  echo "    (needs no admin rights; run brew later for a fuller setup — see README)"
  mkdir -p "$HOME/.local/bin"
  export PATH="$HOME/.local/bin:$PATH"

  arch="$(uname -m)"                       # arm64 (Apple Silicon) or x86_64
  rust_arch="$arch"
  [[ "$arch" == "arm64" ]] && rust_arch="aarch64"   # rust triples use aarch64
  amd_arch="${arch/x86_64/amd64}"          # fzf/gh use amd64 on Intel

  # rust-triple style: <arch>-apple-darwin
  gh_install starship starship/starship "${rust_arch}-apple-darwin.tar.gz$"
  gh_install zoxide   ajeetdsouza/zoxide "${rust_arch}-apple-darwin.tar.gz$"
  gh_install delta    dandavison/delta   "${rust_arch}-apple-darwin.tar.gz$"
  gh_install zellij   zellij-org/zellij  "zellij-${rust_arch}-apple-darwin.tar.gz$"
  gh_install atuin    atuinsh/atuin      "atuin-${rust_arch}-apple-darwin.tar.gz$"
  gh_install bat      sharkdp/bat        "${rust_arch}-apple-darwin.tar.gz$"
  gh_install fd       sharkdp/fd         "${rust_arch}-apple-darwin.tar.gz$"
  gh_install rg       BurntSushi/ripgrep "${rust_arch}-apple-darwin.tar.gz$"
  gh_install dust     bootandy/dust      "${rust_arch}-apple-darwin.tar.gz$"
  gh_install procs    dalance/procs      "${rust_arch}-mac.zip$"
  # go-style names. duf/lazygit/lazydocker/glow use literal arm64 / x86_64;
  # fzf / gh use amd64 on Intel.
  gh_install fzf        junegunn/fzf             "darwin_${amd_arch}.tar.gz$"
  gh_install gh         cli/cli                  "macOS_${amd_arch}.zip$"
  gh_install lazygit    jesseduffield/lazygit    "darwin_${arch}.tar.gz$"
  gh_install lazydocker jesseduffield/lazydocker "Darwin_${arch}.tar.gz$"
  gh_install glow       charmbracelet/glow       "Darwin_${arch}.tar.gz$"
  gh_install duf        muesli/duf               "darwin_${arch}.tar.gz$"

  # neovim (official macOS tarball)
  if ! command -v nvim >/dev/null 2>&1; then
    echo "    install neovim"
    nvim_arch="x86_64"; [[ "$arch" == "arm64" ]] && nvim_arch="arm64"
    tmp="$(mktemp -d)"
    if curl -fsSL "https://github.com/neovim/neovim/releases/latest/download/nvim-macos-${nvim_arch}.tar.gz" -o "$tmp/nvim.tar.gz"; then
      rm -rf "$HOME/.local/nvim"; mkdir -p "$HOME/.local/nvim"
      tar -xzf "$tmp/nvim.tar.gz" -C "$HOME/.local/nvim" --strip-components=1 2>/dev/null
      ln -sf "$HOME/.local/nvim/bin/nvim" "$HOME/.local/bin/nvim"
    fi
    rm -rf "$tmp"
  fi

  # mise (official installer -> ~/.local/bin)
  if ! command -v mise >/dev/null 2>&1; then
    echo "    install mise"
    curl -fsSL https://mise.run | MISE_INSTALL_PATH="$HOME/.local/bin/mise" sh || true
  fi

  # antidote (zsh plugin manager, via git)
  if [[ ! -d "$HOME/.antidote" ]]; then
    git clone --depth=1 https://github.com/mattmc3/antidote.git "$HOME/.antidote" || true
  fi

  cat <<'EOF'
    Note: eza (ll) has no macOS binary release; `ll` falls back to native ls.
          For the full stack (eza, fonts, casks) install Homebrew later:
            /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
            brew bundle --file ~/.config/homebrew/Brewfile
EOF
  exit 0
fi

# Install everything from the Brewfile (single source of truth).
# Read directly from the chezmoi source dir (Brewfile may not be applied yet).
brewfile="{{ .chezmoi.sourceDir }}/dot_config/homebrew/Brewfile"
if [[ -f "$brewfile" ]]; then
  echo ">>> brew bundle (from Brewfile) ..."
  brew bundle --file="$brewfile" || echo "    !! some brew items failed; continuing"
else
  echo "    !! Brewfile not found at $brewfile, skipping brew bundle"
fi

# Fix Homebrew completion dir perms so zsh's compinit doesn't warn about
# "insecure directories" on first launch.
chmod -R go-w "$(brew --prefix)/share/zsh" 2>/dev/null || true

{{ else if eq .chezmoi.os "linux" -}}
# ============================ Linux (NO Homebrew) ============================
# Strategy: apt for base tools; everything else pulled as a static binary from
# each project's GitHub release into ~/.local/bin. No Homebrew, minimal sudo.
mkdir -p "$HOME/.local/bin"
export PATH="$HOME/.local/bin:$PATH"

arch="$(uname -m)"   # x86_64 or aarch64

# --- base packages via apt (REQUIRED) ---------------------------------------
# apt base packages are required; if apt itself fails the machine is unusable
# for the rest of the bootstrap, so let errexit abort here.
if command -v apt-get >/dev/null 2>&1; then
  echo ">>> installing base packages via apt ..."
  sudo apt-get update -y
  sudo apt-get install -y \
    zsh git curl wget file unzip tar build-essential \
    fzf bat fd-find ripgrep tmux \
    jq btop httpie
  # Debian/Ubuntu ship batcat/fdfind; symlink to conventional names.
  command -v batcat >/dev/null 2>&1 && ln -sf "$(command -v batcat)" "$HOME/.local/bin/bat"
  command -v fdfind >/dev/null 2>&1 && ln -sf "$(command -v fdfind)" "$HOME/.local/bin/fd"
fi

# --- track required-tool failures -------------------------------------------
# Individual tool installs below run with errexit OFF (gh_install never aborts).
# But REQUIRED tools that end up missing are collected and, at the very end,
# cause a non-zero exit so chezmoi does NOT mark this run_once script as done
# -> the next `chezmoi apply` retries (e.g. after the network is back).
# Optional tools are best-effort: a failure only prints a note.
failed_required=()
set +e

# require <bin>: record a required tool as failed if its binary is still missing.
require() {
  command -v "$1" >/dev/null 2>&1 || { echo "    !! REQUIRED $1 missing"; failed_required+=("$1"); }
}

# --- modern CLI tools (REQUIRED: the core shell experience depends on these) -
gh_install starship starship/starship "${arch}-unknown-linux-gnu.tar.gz$";      require starship
gh_install zoxide   ajeetdsouza/zoxide "${arch}-unknown-linux-musl.tar.gz$";     require zoxide
gh_install eza      eza-community/eza  "${arch}-unknown-linux-gnu.tar.gz$";      require eza
gh_install delta    dandavison/delta   "${arch}-unknown-linux-gnu.tar.gz$";      require delta
gh_install zellij   zellij-org/zellij  "${arch}-unknown-linux-musl.tar.gz$";     require zellij
gh_install atuin    atuinsh/atuin      "atuin-${arch}-unknown-linux-gnu.tar.gz$"; require atuin

# --- optional extras (best-effort) ------------------------------------------
# lazygit/lazydocker use lowercase 'linux_<arch>' (x86_64/arm64).
lg_arch="${arch/aarch64/arm64}"
gh_install lazygit    jesseduffield/lazygit    "linux_${lg_arch}.tar.gz$"
gh_install lazydocker jesseduffield/lazydocker "Linux_${lg_arch}.tar.gz$"
gh_install dust       bootandy/dust            "dust-.*${arch}-unknown-linux-gnu.tar.gz$"
gh_install duf        muesli/duf               "linux_${arch}.tar.gz$"
gh_install procs      dalance/procs            "${arch}-linux.zip$"
gh_install glow       charmbracelet/glow       "Linux_${arch}.tar.gz$"

# yq (single raw binary asset, not a tarball) -- optional
if ! command -v yq >/dev/null 2>&1; then
  echo "    install yq"
  yq_arch="${arch/x86_64/amd64}"; yq_arch="${yq_arch/aarch64/arm64}"
  curl -fsSL "https://github.com/mikefarah/yq/releases/latest/download/yq_linux_${yq_arch}" \
    -o "$HOME/.local/bin/yq" && chmod +x "$HOME/.local/bin/yq" || echo "    !! optional yq failed, skipping"
fi

# gh (GitHub CLI); binary lives in bin/ inside the tarball -> handled by find -- optional
gh_install gh cli/cli "linux_${arch/x86_64/amd64}.tar.gz"

# tealdeer -> provides the `tldr` command (raw binary asset) -- optional
if ! command -v tldr >/dev/null 2>&1; then
  echo "    install tldr (tealdeer)"
  tldr_arch="${arch/x86_64/x86_64}"; tldr_arch="${tldr_arch/aarch64/aarch64}"
  curl -fsSL "https://github.com/tealdeer-rs/tealdeer/releases/latest/download/tealdeer-linux-${tldr_arch}-musl" \
    -o "$HOME/.local/bin/tldr" && chmod +x "$HOME/.local/bin/tldr" || echo "    !! optional tldr failed, skipping"
fi

# --- mise (official installer -> ~/.local/bin) : REQUIRED -------------------
if ! command -v mise >/dev/null 2>&1; then
  echo "    install mise"
  curl -fsSL https://mise.run | MISE_INSTALL_PATH="$HOME/.local/bin/mise" sh || true
fi
require mise

# --- neovim (full tarball; apt's version is too old for LazyVim) : REQUIRED -
if ! command -v nvim >/dev/null 2>&1; then
  echo "    install neovim"
  nvim_arch="$arch"; [[ "$arch" == "aarch64" ]] && nvim_arch="arm64"
  tmp="$(mktemp -d)"
  if curl -fsSL "https://github.com/neovim/neovim/releases/latest/download/nvim-linux-${nvim_arch}.tar.gz" -o "$tmp/nvim.tar.gz"; then
    rm -rf "$HOME/.local/nvim"; mkdir -p "$HOME/.local/nvim"
    tar -xzf "$tmp/nvim.tar.gz" -C "$HOME/.local/nvim" --strip-components=1
    ln -sf "$HOME/.local/nvim/bin/nvim" "$HOME/.local/bin/nvim"
  fi
  rm -rf "$tmp"
fi
require nvim

# --- antidote (zsh plugin manager, via git) : REQUIRED ----------------------
if [[ ! -d "$HOME/.antidote" ]]; then
  git clone --depth=1 https://github.com/mattmc3/antidote.git "$HOME/.antidote" || true
fi
[[ -d "$HOME/.antidote" ]] || { echo "    !! REQUIRED antidote missing"; failed_required+=("antidote"); }

# --- fail loud if any REQUIRED tool didn't install --------------------------
# Non-zero exit -> chezmoi won't record this run_once as done, so a later
# `chezmoi apply` (after fixing network/rate limits) retries the whole thing.
set -e
if [[ ${#failed_required[@]} -gt 0 ]]; then
  echo ">>> [dotfiles] ERROR: required tools failed to install: ${failed_required[*]}" >&2
  echo ">>> re-run with:  chezmoi apply   (after fixing the cause)" >&2
  exit 1
fi
{{ end -}}

echo ">>> [dotfiles] packages ready."

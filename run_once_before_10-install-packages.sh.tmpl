#!/usr/bin/env bash
# Cross-platform package installer for a fresh machine.
# Runs once (chezmoi tracks its hash). Installs the modern CLI stack that this
# dotfiles setup depends on. Safe to re-run: package managers skip installed pkgs.
set -euo pipefail

echo ">>> [dotfiles] bootstrapping packages ..."

# ---------------------------------------------------------------------------
# Package list (logical names). Mapped per-platform below.
#   starship  - prompt
#   zoxide    - `z` smart dir jump (replaces fasd)
#   fzf       - fuzzy finder
#   eza       - modern `ls` (ll)
#   bat       - modern `cat`
#   fd        - modern `find`
#   ripgrep   - modern `grep` (rg)
#   git-delta - pretty git diffs
#   atuin     - shell history search/sync
#   zellij    - terminal multiplexer
#   neovim    - editor (LazyVim)
#   mise      - runtime version manager (replaces rbenv/nvm, no prompt clutter)
#   antidote  - zsh plugin manager
# ---------------------------------------------------------------------------

{{ if eq .chezmoi.os "darwin" -}}
# ============================ macOS (Homebrew) ============================
# Ensure Xcode Command Line Tools are present (git/clang). On a brand-new Mac
# this may pop a GUI installer dialog you must click through.
if ! xcode-select -p >/dev/null 2>&1; then
  echo ">>> triggering Xcode Command Line Tools install (follow the GUI prompt) ..."
  xcode-select --install || true
  echo ">>> waiting for Command Line Tools to finish installing ..."
  until xcode-select -p >/dev/null 2>&1; do sleep 5; done
fi

if ! command -v brew >/dev/null 2>&1; then
  echo ">>> installing Homebrew ..."
  NONINTERACTIVE=1 /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
fi

# CRITICAL: put brew on PATH for the rest of THIS script (fresh install case).
if [[ -x /opt/homebrew/bin/brew ]]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"      # Apple Silicon
elif [[ -x /usr/local/bin/brew ]]; then
  eval "$(/usr/local/bin/brew shellenv)"         # Intel
fi

brew_pkgs=(
  starship zoxide fzf eza bat fd ripgrep git-delta atuin
  zellij neovim mise antidote tmux
  # modern extras
  lazygit jq yq dust duf procs btop gh tealdeer lazydocker glow httpie
)
for pkg in "${brew_pkgs[@]}"; do
  if brew list --formula "$pkg" >/dev/null 2>&1; then
    echo "    ok   $pkg"
  else
    echo "    install $pkg"
    brew install "$pkg"
  fi
done

# Fix Homebrew completion dir perms so zsh's compinit doesn't warn about
# "insecure directories" on first launch.
chmod -R go-w "$(brew --prefix)/share/zsh" 2>/dev/null || true

# Nerd Font (JetBrainsMono) so starship's git symbols / status dots render.
# Matches the font referenced in ~/.config/ghostty/config.
if brew list --cask font-jetbrains-mono-nerd-font >/dev/null 2>&1; then
  echo "    ok   font-jetbrains-mono-nerd-font"
else
  echo "    install font-jetbrains-mono-nerd-font"
  brew install --cask font-jetbrains-mono-nerd-font
fi

{{ else if eq .chezmoi.os "linux" -}}
# ============================ Linux (NO Homebrew) ============================
# Strategy: apt for base tools; everything else pulled as a static binary from
# each project's GitHub release into ~/.local/bin. No Homebrew, minimal sudo.
mkdir -p "$HOME/.local/bin"
export PATH="$HOME/.local/bin:$PATH"

arch="$(uname -m)"   # x86_64 or aarch64

# --- base packages via apt --------------------------------------------------
if command -v apt-get >/dev/null 2>&1; then
  echo ">>> installing base packages via apt ..."
  sudo apt-get update -y
  sudo apt-get install -y \
    zsh git curl wget file unzip tar build-essential \
    fzf bat fd-find ripgrep tmux \
    jq btop httpie
  # Debian/Ubuntu ship batcat/fdfind; symlink to conventional names.
  command -v batcat >/dev/null 2>&1 && ln -sf "$(command -v batcat)" "$HOME/.local/bin/bat"
  command -v fdfind >/dev/null 2>&1 && ln -sf "$(command -v fdfind)" "$HOME/.local/bin/fd"
fi

# --- helper: install a single-binary tool from a GitHub release tarball -----
# usage: gh_install <bin_name> <owner/repo> <asset_grep_pattern>
gh_install() {
  local bin="$1" repo="$2" pattern="$3"
  if command -v "$bin" >/dev/null 2>&1; then echo "    ok   $bin"; return; fi
  echo "    install $bin (github: $repo)"
  local url
  url=$(curl -fsSL "https://api.github.com/repos/$repo/releases/latest" \
        | grep -oE '"browser_download_url": *"[^"]+"' \
        | cut -d'"' -f4 | grep -E "$pattern" | head -1)
  if [[ -z "$url" ]]; then echo "    !! no matching asset for $bin ($pattern)"; return; fi
  local tmp; tmp="$(mktemp -d)"
  curl -fsSL "$url" -o "$tmp/dl"
  case "$url" in
    *.tar.gz|*.tgz) tar -xzf "$tmp/dl" -C "$tmp" ;;
    *.zip)          unzip -q "$tmp/dl" -d "$tmp" ;;
    *)              cp "$tmp/dl" "$tmp/$bin"; chmod +x "$tmp/$bin" ;;
  esac
  local found; found="$(find "$tmp" -type f -name "$bin" | head -1)"
  if [[ -n "$found" ]]; then install -m755 "$found" "$HOME/.local/bin/$bin"; fi
  rm -rf "$tmp"
}

# --- modern CLI tools (static binaries) -------------------------------------
gh_install starship starship/starship "${arch}-unknown-linux-gnu.tar.gz"
gh_install zoxide   ajeetdsouza/zoxide "${arch}-unknown-linux-musl.tar.gz"
gh_install eza      eza-community/eza  "${arch}-unknown-linux-gnu.tar.gz"
gh_install delta    dandavison/delta   "${arch}-unknown-linux-gnu.tar.gz"
gh_install zellij   zellij-org/zellij  "${arch}-unknown-linux-musl.tar.gz"
gh_install atuin    atuinsh/atuin      "${arch}-unknown-linux-gnu.tar.gz"

# modern extras (tarball-based, single binary inside)
gh_install lazygit    jesseduffield/lazygit    "Linux_${arch/x86_64/x86_64}.tar.gz"
gh_install lazydocker jesseduffield/lazydocker "Linux_${arch/x86_64/x86_64}.tar.gz"
gh_install dust       bootandy/dust            "${arch}-unknown-linux-gnu.tar.gz"
gh_install duf        muesli/duf               "linux_${arch/x86_64/amd64}.tar.gz"
gh_install procs      dalance/procs            "${arch}-linux.zip"
gh_install glow       charmbracelet/glow       "Linux_${arch/x86_64/x86_64}.tar.gz"

# yq (single raw binary asset, not a tarball)
if ! command -v yq >/dev/null 2>&1; then
  echo "    install yq"
  yq_arch="${arch/x86_64/amd64}"; yq_arch="${yq_arch/aarch64/arm64}"
  curl -fsSL "https://github.com/mikefarah/yq/releases/latest/download/yq_linux_${yq_arch}" \
    -o "$HOME/.local/bin/yq" && chmod +x "$HOME/.local/bin/yq"
fi

# gh (GitHub CLI); binary lives in bin/ inside the tarball -> handled by find
gh_install gh cli/cli "linux_${arch/x86_64/amd64}.tar.gz"

# tealdeer -> provides the `tldr` command (raw binary asset)
if ! command -v tldr >/dev/null 2>&1; then
  echo "    install tldr (tealdeer)"
  tldr_arch="${arch/x86_64/x86_64}"; tldr_arch="${tldr_arch/aarch64/aarch64}"
  curl -fsSL "https://github.com/tealdeer-rs/tealdeer/releases/latest/download/tealdeer-linux-${tldr_arch}-musl" \
    -o "$HOME/.local/bin/tldr" && chmod +x "$HOME/.local/bin/tldr"
fi

# --- mise (official installer -> ~/.local/bin) ------------------------------
if ! command -v mise >/dev/null 2>&1; then
  echo "    install mise"
  curl -fsSL https://mise.run | MISE_INSTALL_PATH="$HOME/.local/bin/mise" sh
fi

# --- neovim (full tarball; apt's version is too old for LazyVim) ------------
if ! command -v nvim >/dev/null 2>&1; then
  echo "    install neovim"
  nvim_arch="$arch"; [[ "$arch" == "aarch64" ]] && nvim_arch="arm64"
  tmp="$(mktemp -d)"
  if curl -fsSL "https://github.com/neovim/neovim/releases/latest/download/nvim-linux-${nvim_arch}.tar.gz" -o "$tmp/nvim.tar.gz"; then
    rm -rf "$HOME/.local/nvim"; mkdir -p "$HOME/.local/nvim"
    tar -xzf "$tmp/nvim.tar.gz" -C "$HOME/.local/nvim" --strip-components=1
    ln -sf "$HOME/.local/nvim/bin/nvim" "$HOME/.local/bin/nvim"
  fi
  rm -rf "$tmp"
fi

# --- antidote (zsh plugin manager, via git) ---------------------------------
if [[ ! -d "$HOME/.antidote" ]]; then
  git clone --depth=1 https://github.com/mattmc3/antidote.git "$HOME/.antidote"
fi
{{ end -}}

echo ">>> [dotfiles] packages ready."

#!/usr/bin/env bash
# macos-defaults - opt-in macOS system tweaks. NOT run automatically.
# Run manually once per new Mac:  macos-defaults
# Every change is reversible; see the `defaults delete` / UI equivalent noted.
set -euo pipefail

if [[ "$(uname)" != "Darwin" ]]; then
  echo "macos-defaults: this script only applies to macOS." >&2
  exit 1
fi

echo ">>> applying macOS defaults (you can re-run anytime; some need re-login) ..."

# --- Keyboard: fast key repeat, short delay (great for vim/nav) ------------
defaults write NSGlobalDomain KeyRepeat -int 2          # 1=fastest, 2=very fast
defaults write NSGlobalDomain InitialKeyRepeat -int 15  # lower = shorter delay
defaults write NSGlobalDomain ApplePressAndHoldEnabled -bool false  # repeat, not accent popup

# --- Finder ----------------------------------------------------------------
defaults write com.apple.finder AppleShowAllFiles -bool true         # show hidden files
defaults write NSGlobalDomain AppleShowAllExtensions -bool true       # show all file extensions
defaults write com.apple.finder ShowPathbar -bool true                # bottom path bar
defaults write com.apple.finder ShowStatusBar -bool true              # status bar
defaults write com.apple.finder FXPreferredViewStyle -string "Nlsv"   # list view by default
defaults write com.apple.finder _FXSortFoldersFirst -bool true        # folders on top
defaults write com.apple.finder FXDefaultSearchScope -string "SCcf"   # search current folder
# don't write .DS_Store on network/USB volumes
defaults write com.apple.desktopservices DSDontWriteNetworkStores -bool true
defaults write com.apple.desktopservices DSDontWriteUSBStores -bool true

# --- Dock ------------------------------------------------------------------
defaults write com.apple.dock autohide -bool true                     # auto-hide dock
defaults write com.apple.dock autohide-delay -float 0                 # no show delay
defaults write com.apple.dock autohide-time-modifier -float 0.15      # faster animation
defaults write com.apple.dock show-recents -bool false                # no recent apps
defaults write com.apple.dock mru-spaces -bool false                  # don't reorder spaces
defaults write com.apple.dock tilesize -int 44                        # icon size

# --- Screenshots -----------------------------------------------------------
mkdir -p "${HOME}/Screenshots"
defaults write com.apple.screencapture location -string "${HOME}/Screenshots"
defaults write com.apple.screencapture type -string "png"
defaults write com.apple.screencapture disable-shadow -bool true

# --- Misc quality-of-life --------------------------------------------------
defaults write NSGlobalDomain NSAutomaticCapitalizationEnabled -bool false
defaults write NSGlobalDomain NSAutomaticDashSubstitutionEnabled -bool false
defaults write NSGlobalDomain NSAutomaticQuoteSubstitutionEnabled -bool false  # no smart quotes (bad for code)
defaults write NSGlobalDomain NSAutomaticSpellingCorrectionEnabled -bool false
defaults write NSGlobalDomain NSNavPanelExpandedStateForSaveMode -bool true    # expanded save dialog
defaults write NSGlobalDomain PMPrintingExpandedStateForPrint -bool true       # expanded print dialog
defaults write com.apple.LaunchServices LSQuarantine -bool false               # no "are you sure?" for downloaded apps

# --- Apply: restart affected UI services -----------------------------------
for app in Finder Dock SystemUIServer; do
  killall "$app" >/dev/null 2>&1 || true
done

cat <<'EOF'
>>> done. Some settings (keyboard repeat) take effect after logout/restart.
    To undo a specific tweak, use the matching `defaults delete` or toggle it
    back in System Settings. Nothing here is destructive.
EOF

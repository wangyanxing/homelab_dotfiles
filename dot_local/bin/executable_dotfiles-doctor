#!/usr/bin/env bash
# dotfiles-doctor - health check for this dotfiles setup.
# Verifies that expected tools, symlinks and configs are in place.
# Usage: dotfiles-doctor
set -uo pipefail

ok=0; warn=0; miss=0
green="\033[32m"; yellow="\033[33m"; red="\033[31m"; dim="\033[2m"; rst="\033[0m"

section() { printf "\n${dim}== %s ==${rst}\n" "$1"; }
# short version string for a tool (first line, trimmed); empty if none.
_ver() {
  local v
  v="$("$1" --version 2>/dev/null | head -1)" || v=""
  [[ -z "$v" ]] && v="$("$1" -V 2>/dev/null | head -1)"
  echo "$v"
}
check_cmd() {
  local name="$1" why="${2:-}"
  if command -v "$name" >/dev/null 2>&1; then
    printf "  ${green}ok${rst}   %-12s ${dim}%s${rst}\n" "$name" "$(_ver "$name")"
    ok=$((ok+1))
  else
    printf "  ${red}MISS${rst} %-12s ${dim}%s${rst}\n" "$name" "$why"
    miss=$((miss+1))
  fi
}
# like check_cmd but a miss is only a warning (optional / platform-specific).
check_opt() {
  local name="$1" why="${2:-}"
  if command -v "$name" >/dev/null 2>&1; then
    printf "  ${green}ok${rst}   %-12s ${dim}%s${rst}\n" "$name" "$(_ver "$name")"
    ok=$((ok+1))
  else
    printf "  ${yellow}warn${rst} %-12s ${dim}%s${rst}\n" "$name" "$why"
    warn=$((warn+1))
  fi
}
check_file() {
  local f="$1"
  if [[ -e "${f/#\~/$HOME}" ]]; then
    printf "  ${green}ok${rst}   %s\n" "$f"; ok=$((ok+1))
  else
    printf "  ${yellow}warn${rst} %s ${dim}(missing)${rst}\n" "$f"; warn=$((warn+1))
  fi
}

echo "dotfiles-doctor - checking your environment"

section "core"
check_cmd zsh
check_cmd git
check_cmd chezmoi "install: sh -c \"\$(curl -fsLS get.chezmoi.io)\" -- -b ~/.local/bin"
check_opt dotfiles-install "helper to re-run the installer (ships in ~/.local/bin)"
check_cmd starship
check_cmd zoxide
check_cmd fzf
check_cmd nvim

section "modern CLI"
for t in bat fd rg delta atuin mise zellij tmux; do check_cmd "$t"; done
# eza has no macOS binary release; `ll` falls back to native ls, so it's optional.
check_opt eza "optional on macOS (ll falls back to ls)"

section "extras"
for t in lazygit lazydocker jq yq dust duf procs btop gh tldr glow http; do check_opt "$t"; done

section "config files"
check_file "~/.zshrc"
check_file "~/.zshenv"
check_file "~/.gitconfig"
check_file "~/.config/starship.toml"
check_file "~/.config/zsh/aliases.zsh"
check_file "~/.config/nvim/init.lua"
check_file "~/.config/nvim/lazyvim.json"
check_file "~/.config/zellij/config.kdl"
check_file "~/.config/mise/config.toml"
check_file "~/.tmux.conf"
check_file "~/.zsh_plugins.txt"

section "shell & path"
[[ "$SHELL" == *zsh ]] && printf "  ${green}ok${rst}   default shell is zsh\n" || printf "  ${yellow}warn${rst} default shell is '$SHELL' (run: chsh -s \$(command -v zsh))\n"
case ":$PATH:" in *":$HOME/.local/bin:"*) printf "  ${green}ok${rst}   ~/.local/bin on PATH\n";; *) printf "  ${yellow}warn${rst} ~/.local/bin NOT on PATH\n";; esac

section "package manager"
if [[ "$(uname)" == "Darwin" ]]; then
  if command -v brew >/dev/null 2>&1; then
    printf "  ${green}ok${rst}   homebrew   ${dim}%s${rst}\n" "$(brew --prefix 2>/dev/null)"
  else
    printf "  ${yellow}warn${rst} homebrew not installed ${dim}(tools came from ~/.local/bin fallback)${rst}\n"
  fi
else
  command -v apt-get >/dev/null 2>&1 && printf "  ${green}ok${rst}   apt available\n" || printf "  ${yellow}warn${rst} apt not found\n"
fi

section "git identity"
name="$(git config --get user.name 2>/dev/null || true)"
email="$(git config --get user.email 2>/dev/null || true)"
[[ -n "$name" ]] && printf "  ${green}ok${rst}   user.name  = %s\n" "$name" || printf "  ${yellow}warn${rst} git user.name not set\n"
[[ -n "$email" ]] && printf "  ${green}ok${rst}   user.email = %s\n" "$email" || printf "  ${yellow}warn${rst} git user.email not set\n"

section "github ssh"
if ls "$HOME"/.ssh/id_* >/dev/null 2>&1; then
  printf "  ${green}ok${rst}   ssh key present ${dim}(%s)${rst}\n" "$(ls "$HOME"/.ssh/id_*.pub 2>/dev/null | head -1)"
  if ssh -o BatchMode=yes -o ConnectTimeout=5 -T git@github.com 2>&1 | grep -q "successfully authenticated"; then
    printf "  ${green}ok${rst}   authenticated to github.com\n"
  else
    printf "  ${yellow}warn${rst} key not authenticated to github ${dim}(add ~/.ssh/id_*.pub at github.com/settings/keys)${rst}\n"
  fi
else
  printf "  ${yellow}warn${rst} no ssh key ${dim}(ssh-keygen -t ed25519, then add to github)${rst}\n"
fi

section "config drift"
# Detect files you edited directly in $HOME that haven't been written back to
# the chezmoi source repo — those get reverted on the next `chezmoi apply`.
if command -v chezmoi >/dev/null 2>&1; then
  drift="$(chezmoi status 2>/dev/null)"
  if [[ -z "$drift" ]]; then
    printf "  ${green}ok${rst}   no drift ${dim}(\$HOME matches the repo)${rst}\n"; ok=$((ok+1))
  else
    printf "  ${yellow}warn${rst} local edits not in repo ${dim}(chezmoi diff / re-add via chezmoi add)${rst}\n"; warn=$((warn+1))
    echo "$drift" | sed 's/^/       /'
  fi
else
  printf "  ${yellow}warn${rst} chezmoi not on PATH; can't check drift\n"; warn=$((warn+1))
fi

section "secrets (age)"
# age encryption is optional; only flag a broken half-setup (key without tool
# or vice-versa). No key at all is fine — just informational.
key="$HOME/.config/chezmoi/key.txt"
if [[ -f "$key" ]] && command -v age-keygen >/dev/null 2>&1; then
  printf "  ${green}ok${rst}   age key + tools present ${dim}(encrypted secrets ready)${rst}\n"; ok=$((ok+1))
elif [[ -f "$key" ]]; then
  printf "  ${yellow}warn${rst} age key present but age-keygen missing ${dim}(install age)${rst}\n"; warn=$((warn+1))
elif command -v age-keygen >/dev/null 2>&1; then
  printf "  ${dim}--   age installed, no key yet (secrets optional; see README)${rst}\n"
else
  printf "  ${dim}--   age not configured (secrets optional; see README)${rst}\n"
fi

printf "\n${green}%d ok${rst}, ${yellow}%d warn${rst}, ${red}%d missing${rst}\n" "$ok" "$warn" "$miss"
[[ "$miss" -eq 0 ]] || echo "Tip: fill in missing tools with -> dotfiles-install"

# ~/.tmux.conf - kept as a fallback while migrating to zellij.
# Sensible modern defaults; Ctrl-b prefix (same as zellij's tmux mode above).

# --- General ---------------------------------------------------------------
set -g default-terminal "tmux-256color"
set -ga terminal-overrides ",*256col*:Tc"   # truecolor
set -g mouse on
set -g history-limit 50000
set -g base-index 1                          # windows start at 1
setw -g pane-base-index 1
set -g renumber-windows on
set -sg escape-time 0                         # no delay for ESC (vim)
set -g focus-events on

# --- Splits: keep tmux muscle memory ---------------------------------------
bind % split-window -h -c "#{pane_current_path}"
bind '"' split-window -v -c "#{pane_current_path}"
bind c new-window -c "#{pane_current_path}"

# --- Vim-style pane navigation ---------------------------------------------
bind h select-pane -L
bind j select-pane -D
bind k select-pane -U
bind l select-pane -R

# --- Pane resize (repeatable: hold prefix, tap H/J/K/L) --------------------
bind -r H resize-pane -L 5
bind -r J resize-pane -D 5
bind -r K resize-pane -U 5
bind -r L resize-pane -R 5

# --- Zoom / fullscreen a pane (matches zellij Ctrl-b z) --------------------
bind z resize-pane -Z

# --- Window switching (matches zellij Ctrl-b n/p) --------------------------
bind -r n next-window
bind -r p previous-window

# --- Reload config ----------------------------------------------------------
bind r source-file ~/.tmux.conf \; display "tmux.conf reloaded"

# --- Copy mode (vi) ---------------------------------------------------------
setw -g mode-keys vi
bind -T copy-mode-vi v send -X begin-selection
bind -T copy-mode-vi y send -X copy-selection-and-cancel
{{ if eq .chezmoi.os "darwin" -}}
bind -T copy-mode-vi y send -X copy-pipe-and-cancel "pbcopy"
{{ end -}}

# --- Status bar (tokyonight — unified with zellij / nvim) ------------------
# palette: bg #1a1b26  fg #a9b1d6  blue #7aa2f7  green #9ece6a  purple #bb9af7
set -g status-style "bg=#1a1b26 fg=#a9b1d6"
set -g status-left "#[fg=#7aa2f7,bold] #S #[default] "
set -g status-left-length 30
set -g status-right "#[fg=#bb9af7]%Y-%m-%d #[fg=#7aa2f7]%H:%M "
set -g status-justify left
setw -g window-status-format "#[fg=#565f89] #I:#W "
setw -g window-status-current-format "#[fg=#1a1b26,bg=#7aa2f7,bold] #I:#W #[default]"
set -g pane-border-style "fg=#3b4261"
set -g pane-active-border-style "fg=#7aa2f7"
set -g message-style "bg=#7aa2f7,fg=#1a1b26"

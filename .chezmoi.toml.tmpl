{{- /* Prompted once on `chezmoi init`; answers stored in the local config. */ -}}
{{- $editor := "nvim" -}}
{{- $name := promptStringOnce . "name" "Git user name" -}}
{{- $email := promptStringOnce . "email" "Git email" -}}
{{- /* secrets: auto-enable age encryption when a key is present. Zero setup
       cost when you don't use secrets — this whole block is skipped unless
       ~/.config/chezmoi/key.txt exists AND age-keygen is on PATH. The public
       recipient is derived from the private key, so you never edit this file. */ -}}
{{- $keyFile := joinPath .chezmoi.homeDir ".config/chezmoi/key.txt" -}}
{{- $ageReady := and (lookPath "age-keygen") (stat $keyFile) -}}

[edit]
    command = "nvim"

[data]
    editor = {{ $editor | quote }}
    name = {{ $name | quote }}
    email = {{ $email | quote }}
{{ if $ageReady }}
encryption = "age"

[age]
    identity = {{ $keyFile | quote }}
    recipient = {{ output "age-keygen" "-y" $keyFile | trim | quote }}
{{ end -}}

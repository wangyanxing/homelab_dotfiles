# ~/.zshenv - loaded for every zsh (login, interactive, scripts)
# Keep this minimal: only env vars needed everywhere.

# Ensure local bin (Linux symlinks for bat/fd) and Homebrew are on PATH.
export PATH="$HOME/.local/bin:$HOME/bin:$PATH"

# Homebrew (macOS Apple Silicon / Intel / Linuxbrew)
if [[ -x /opt/homebrew/bin/brew ]]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
elif [[ -x /usr/local/bin/brew ]]; then
  eval "$(/usr/local/bin/brew shellenv)"
elif [[ -x /home/linuxbrew/.linuxbrew/bin/brew ]]; then
  eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
fi

# Default editor
export EDITOR="{{ .editor }}"
export VISUAL="{{ .editor }}"

# XDG base dirs
export XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
export XDG_CACHE_HOME="${XDG_CACHE_HOME:-$HOME/.cache}"
export XDG_DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
